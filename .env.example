# Copy to .env.local (frontend) and .env (backend) and fill in values.

# ── Frontend (Vite) ────────────────────────────────────────────
# When set, the app fetches clients from the FastAPI backend.
# When unset, it falls back to static JSON files in public/data/.
VITE_API_URL=http://localhost:8000

# ── Backend (FastAPI) ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://advisoriq:advisoriq@localhost:5432/advisoriq
DATABASE_URL_SYNC=postgresql://advisoriq:advisoriq@localhost:5432/advisoriq
